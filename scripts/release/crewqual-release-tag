#!/usr/bin/env bash
set -Eeuo pipefail

readonly DEFAULT_REPO="/root/crewqual"
readonly DEFAULT_KEY_DIR="/root/crewqual-release-keys"
readonly DEFAULT_GPG_FINGERPRINT="25FE16137039EC8C0398A3471F9794B4266F2C1E"
readonly EXPECTED_REPOSITORY="FlightDan/crewqual"

REPO_DIR="${CREWQUAL_REPO_DIR:-$DEFAULT_REPO}"
KEY_DIR="${CREWQUAL_RELEASE_KEY_DIR:-$DEFAULT_KEY_DIR}"
GPG_FINGERPRINT="${CREWQUAL_GPG_FINGERPRINT:-$DEFAULT_GPG_FINGERPRINT}"
GITHUB_REPOSITORY="${CREWQUAL_GITHUB_REPOSITORY:-$EXPECTED_REPOSITORY}"

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

usage() {
  local code="${1:-2}"
  cat >&2 <<'EOF'
Usage:
  crewqual-release-tag setup
  crewqual-release-tag status
  crewqual-release-tag unlock
  crewqual-release-tag sign [TAG] [TARGET] [MESSAGE] [--strict-clean]
  crewqual-release-tag verify TAG
  crewqual-release-tag github-sync

Environment:
  CREWQUAL_REPO_DIR          Repository directory (default: /root/crewqual)
  CREWQUAL_RELEASE_KEY_DIR   Local signing metadata directory (default: /root/crewqual-release-keys)
  CREWQUAL_GPG_FINGERPRINT   Primary GPG fingerprint
  CREWQUAL_GITHUB_REPOSITORY GitHub repository (default: FlightDan/crewqual)

Optional local passphrase file:
  /root/crewqual-release-keys/gpg-passphrase
  Keep it empty to use gpg-agent. If filled, it must contain one passphrase line
  and remain mode 0600; it is never committed or printed by this script.
EOF
  exit "$code"
}

ensure_repo() {
  [[ -d "$REPO_DIR/.git" ]] || die "not a Git repository: $REPO_DIR"
  git -C "$REPO_DIR" remote get-url origin >/dev/null 2>&1 || die "repository has no origin remote"
}

ensure_secure_dir() {
  mkdir -p -m 700 "$KEY_DIR"
  chmod 700 "$KEY_DIR"
  [[ "$(stat -c '%a' "$KEY_DIR")" == "700" ]] || die "key directory must have mode 0700"
  [[ "$(stat -c '%u' "$KEY_DIR")" == "$(id -u)" ]] || die "key directory must be owned by the current user"
  if [[ "$KEY_DIR" == /root/* && "$(id -u)" != 0 ]]; then
    die "a key directory under /root must be managed by root"
  fi
}

ensure_passphrase_file() {
  local path="$KEY_DIR/gpg-passphrase"
  if [[ ! -e "$path" ]]; then
    : > "$path"
    chmod 600 "$path"
  fi
  [[ ! -L "$path" ]] || die "passphrase file must not be a symbolic link"
  [[ -f "$path" ]] || die "passphrase path must be a regular file"
  [[ "$(stat -c '%a' "$path")" == "600" ]] || die "passphrase file must have mode 0600"
  [[ "$(stat -c '%u' "$path")" == "$(id -u)" ]] || die "passphrase file must be owned by the current user"
}

ensure_gpg_key() {
  [[ "$GPG_FINGERPRINT" =~ ^[A-Fa-f0-9]{40}$ ]] || die "invalid GPG fingerprint"
  gpg --batch --list-secret-keys "$GPG_FINGERPRINT" >/dev/null 2>&1 || \
    die "GPG secret key is not available: $GPG_FINGERPRINT"
}

atomic_install() {
  local source="$1"
  local target="$2"
  local mode="$3"
  local temporary
  temporary="$(mktemp "$KEY_DIR/.crewqual-signing.XXXXXX")"
  cp "$source" "$temporary"
  chmod "$mode" "$temporary"
  mv -f "$temporary" "$target"
}

export_gpg_metadata() {
  ensure_secure_dir
  ensure_gpg_key
  local armored="$KEY_DIR/tag-signing-key.asc"
  local encoded="$KEY_DIR/.tag-signing-key.b64"
  local env_file="$KEY_DIR/tag-signing.env"
  local temporary

  temporary="$(mktemp "$KEY_DIR/.crewqual-signing.XXXXXX")"
  gpg --batch --armor --export "$GPG_FINGERPRINT" > "$temporary"
  chmod 600 "$temporary"
  if [[ -e "$armored" ]]; then
    cmp -s "$temporary" "$armored" || die "existing exported GPG public key differs; refusing to overwrite"
    rm -f "$temporary"
  else
    mv "$temporary" "$armored"
  fi

  base64 -w0 < "$armored" > "$encoded"
  chmod 600 "$encoded"
  temporary="$(mktemp "$KEY_DIR/.crewqual-signing.XXXXXX")"
  {
    printf '%s\n' '# Generated by crewqual-release-tag; do not commit.'
    printf "export RELEASE_TAG_SIGNING_PUBLIC_KEY_B64='%s'\n" "$(cat "$encoded")"
    printf "export RELEASE_SIGNER_FINGERPRINTS='%s'\n" "$GPG_FINGERPRINT"
  } > "$temporary"
  chmod 600 "$temporary"
  mv -f "$temporary" "$env_file"
  rm -f "$encoded"
  printf '%s\n' "GPG public key: $armored" "GPG environment: $env_file"
}

tag_exists() {
  git -C "$REPO_DIR" rev-parse --verify --quiet "refs/tags/$1" >/dev/null
}

validate_tag_name() {
  [[ "$1" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-rc\.[1-9][0-9]*)?$ ]] || \
    die "invalid release tag: $1"
}

verify_tag() {
  local tag="$1"
  validate_tag_name "$tag"
  local raw signing_fpr primary_fpr
  raw="$(git -C "$REPO_DIR" verify-tag --raw "$tag" 2>&1)" || {
    printf '%s\n' "$raw" >&2
    die "tag verification failed: $tag"
  }
  signing_fpr="$(printf '%s\n' "$raw" | awk '$1=="[GNUPG:]" && $2=="VALIDSIG" {print toupper($3); exit}')"
  primary_fpr="$(printf '%s\n' "$raw" | awk '$1=="[GNUPG:]" && $2=="VALIDSIG" {print toupper($NF); exit}')"
  [[ -n "$signing_fpr" && -n "$primary_fpr" ]] || die "git verify-tag did not return a VALIDSIG record"
  [[ "$primary_fpr" == "${GPG_FINGERPRINT^^}" ]] || \
    die "tag primary fingerprint $primary_fpr does not match configured $GPG_FINGERPRINT"
  printf '%s\n' "tag=$tag" "signingFingerprint=$signing_fpr" "primaryFingerprint=$primary_fpr"
}

unlock_gpg_agent() {
  ensure_gpg_key
  export GPG_TTY="${GPG_TTY:-$(tty 2>/dev/null || true)}"
  printf 'CrewQual GPG agent unlock probe\n' | gpg --local-user "$GPG_FINGERPRINT" --armor --sign >/dev/null || \
    die "GPG agent unlock failed"
  printf '%s\n' "GPG agent unlocked; the passphrase was not written to disk by this script"
}

sign_tag() {
  local tag="$1"
  local target="${2:-HEAD}"
  local message="${3:-CrewQual release $tag}"
  local strict_clean="${4:-0}"
  validate_tag_name "$tag"
  ensure_repo
  ensure_secure_dir
  ensure_passphrase_file
  ensure_gpg_key
  tag_exists "$tag" && die "tag already exists: $tag"
  local dirty_files
  dirty_files="$(git -C "$REPO_DIR" status --porcelain)"
  if [[ -n "$dirty_files" ]]; then
    if [[ "$strict_clean" == "1" ]]; then
      die "working tree is dirty; omit --strict-clean or commit/stash changes first"
    fi
    printf '%s\n' "Warning: working tree is dirty; the signed tag will include only committed target $target (not uncommitted files)." >&2
  fi
  git -C "$REPO_DIR" rev-parse --verify "${target}^{commit}" >/dev/null || \
    die "target is not a commit: $target"
  export GPG_TTY="${GPG_TTY:-$(tty 2>/dev/null || true)}"
  local gpg_program="$(command -v gpg)"
  if [[ -x "$KEY_DIR/crewqual-gpg-wrapper" ]]; then
    gpg_program="$KEY_DIR/crewqual-gpg-wrapper"
  fi
  git -C "$REPO_DIR" -c "gpg.program=$gpg_program" tag --sign --local-user "$GPG_FINGERPRINT" --message "$message" "$tag" "$target"
  verify_tag "$tag"
  export_gpg_metadata >/dev/null
  printf '%s\n' "signedTag=$tag" "target=$(git -C "$REPO_DIR" rev-parse "${target}^{commit}")"
}

github_sync() {
  [[ -f "$KEY_DIR/tag-signing.env" ]] || export_gpg_metadata >/dev/null
  # shellcheck disable=SC1091
  source "$KEY_DIR/tag-signing.env"
  gh auth status --hostname github.com >/dev/null
  printf '%s' "$RELEASE_TAG_SIGNING_PUBLIC_KEY_B64" | gh secret set RELEASE_TAG_SIGNING_PUBLIC_KEY_B64 --repo "$GITHUB_REPOSITORY"
  printf '%s' "$RELEASE_SIGNER_FINGERPRINTS" | gh secret set RELEASE_SIGNER_FINGERPRINTS --repo "$GITHUB_REPOSITORY"
  printf '%s\n' "GitHub Actions GPG verification secrets synchronized for $GITHUB_REPOSITORY"
}

command="${1:-}"
case "$command" in
  -h|--help) usage 0 ;;
  setup)
    ensure_gpg_key
    ensure_secure_dir
    ensure_passphrase_file
    export_gpg_metadata
    printf '%s\n' "Optional passphrase file: $KEY_DIR/gpg-passphrase"
    ;;
  status)
    ensure_repo
    ensure_gpg_key
    ensure_secure_dir
    ensure_passphrase_file
    printf '%s\n' "repository=$REPO_DIR" "gpgFingerprint=$GPG_FINGERPRINT"
    export_gpg_metadata >/dev/null
    ;;
  unlock) [[ $# -eq 1 ]] || usage; unlock_gpg_agent ;;
  sign)
    strict_clean=0
    sign_args=()
    for arg in "${@:2}"; do
      if [[ "$arg" == "--strict-clean" ]]; then
        strict_clean=1
      else
        sign_args+=("$arg")
      fi
    done
    [[ "${#sign_args[@]}" -le 3 ]] || usage
    tag="${sign_args[0]:-}"
    if [[ -z "$tag" ]]; then
      [[ -t 0 ]] || die "tag is required when stdin is not interactive"
      read -r -p "Release tag (vX.Y.Z or vX.Y.Z-rc.N): " tag
    fi
    [[ -n "$tag" ]] || die "release tag cannot be empty"
    sign_tag "$tag" "${sign_args[1]:-HEAD}" "${sign_args[2]:-CrewQual release $tag}" "$strict_clean"
    ;;
  verify)
    [[ $# -eq 2 ]] || usage
    ensure_repo
    ensure_gpg_key
    verify_tag "$2"
    ;;
  github-sync) github_sync ;;
  *) usage ;;
esac
