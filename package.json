{
  "name": "crewqual-ui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:worker": "tsx src/worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:remote": "node scripts/run-remote-e2e.mjs",
    "test:integration:recognition": "tsx scripts/recognition-pgboss-e2e.ts",
    "build": "prisma generate && next build",
    "format": "prettier --check .",
    "verify": "corepack pnpm format && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:bootstrap": "tsx scripts/migrate-member-architecture.ts && tsx scripts/bootstrap-production.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:members": "tsx scripts/migrate-member-architecture.ts",
    "db:seed": "tsx prisma/seed.ts && tsx scripts/migrate-member-architecture.ts",
    "db:e2e:prepare": "tsx scripts/remote-e2e-prepare.ts",
    "db:studio": "prisma studio",
    "admin:create": "tsx scripts/admin.ts create",
    "admin:reset": "tsx scripts/admin.ts reset",
    "admin:rotate-password": "tsx scripts/admin.ts rotate-password",
    "security:migrate-totp": "tsx scripts/migrate-totp-secrets.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@tanstack/react-query": "^5.85.5",
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "argon2": "^0.44.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.2",
    "pg": "^8.22.0",
    "pg-boss": "^12.26.3",
    "react-image-crop": "^11.0.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.20.3",
    "sharp": "^0.34.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/pg": "^8.15.5",
    "prisma": "^7.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
