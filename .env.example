NODE_ENV=production
SERVICE_MODE=remote
NEXT_PUBLIC_SERVICE_MODE=remote
# APP_ORIGIN must exactly match the public HTTPS origin; APP_DOMAIN is a hostname only.
APP_ORIGIN=https://crewqual.example.com
APP_DOMAIN=crewqual.example.com
TLS_EMAIL=ops@example.com
# Use one URL-safe random password in all three database fields.
POSTGRES_PASSWORD=replace-with-url-safe-random-value
DATABASE_URL=postgresql://crewqual:replace-with-same-password@postgres:5432/crewqual
DIRECT_URL=postgresql://crewqual:replace-with-same-password@postgres:5432/crewqual
# Generate two distinct values: openssl rand -hex 48 and openssl rand -hex 32.
SESSION_SECRET=replace-with-at-least-48-characters
SETTINGS_ENCRYPTION_KEY=replace-with-a-distinct-at-least-32-character-value
PILOT_SESSION_TTL_MINUTES=60
ADMIN_SESSION_TTL_HOURS=8
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=crewqual-private
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-at-least-16-characters
S3_FORCE_PATH_STYLE=false
QWEN_BASE_URL=http://host.docker.internal:8000/v1
QWEN_MODEL=Qwen3.7-35B
SMS_ADAPTER=webhook
SMS_WEBHOOK_URL=https://sms.example.com/send
SMS_WEBHOOK_AUTH_TOKEN=
# Production containers fail closed unless SMS_ADAPTER=webhook and
# SMS_WEBHOOK_URL is a real reachable provider endpoint.
FEISHU_ADAPTER=disabled
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_AUTH_TOKEN=
VLM_ADAPTER=qwen

INITIAL_ADMIN_EMAIL=admin@example.com
# Used only if no active super administrator exists. Remove both secrets after first login.
INITIAL_ADMIN_PASSWORD=replace-with-at-least-12-characters
INITIAL_ADMIN_TOTP_SECRET=REPLACEWITHBASE32SECRET
