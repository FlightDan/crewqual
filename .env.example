NODE_ENV=production
SERVICE_MODE=remote
NEXT_PUBLIC_SERVICE_MODE=remote
# The installer writes signed image digests from the selected Release manifest.
# This legacy key is accepted only if it is already in the built-in updater keyring.
CREWQUAL_UPDATER_TRUSTED_PUBLIC_KEY=
CREWQUAL_WEB_IMAGE=ghcr.io/flightdan/crewqual-web@sha256:replace-with-release-digest
CREWQUAL_RUNTIME_IMAGE=ghcr.io/flightdan/crewqual-runtime@sha256:replace-with-release-digest
# managed on regular Linux; the installer selects manual in WSL2.
CREWQUAL_UPDATER_MODE=managed
CREWQUAL_UPDATER_HOST_DIR=/run/crewqual-updater
CREWQUAL_UPDATER_SOCKET=/run/crewqual-updater/api.sock
CREWQUAL_UPDATER_SHARED_SECRET=
CREWQUAL_UPDATER_BACKUP_KEY=
# APP_ORIGIN must exactly match the selected mode: an HTTPS origin in TLS mode,
# a private HTTP origin in LAN mode, or a public HTTP origin in temporary HTTP mode.
APP_ORIGIN=https://crewqual.example.com
APP_DOMAIN=crewqual.example.com
TLS_EMAIL=ops@example.com
# Supported values: lan, http, tls.
DEPLOYMENT_NETWORK_MODE=tls
APP_PORT=443
CADDY_SITE_ADDRESS=crewqual.example.com
APP_BIND=0.0.0.0
ACME_BIND=0.0.0.0
ACME_PORT=80
NETWORK_ACCESS_SECRET=replace-with-a-random-secret
SETUP_AUTH_CODE_HASH=sha256-of-the-one-time-8-digit-setup-code
# POSTGRES_PASSWORD belongs to the owner/migration role. The application uses
# the separate crewqual_app login and must never receive the owner password.
POSTGRES_PASSWORD=replace-with-owner-url-safe-random-value
POSTGRES_APP_PASSWORD=replace-with-runtime-url-safe-random-value
DATABASE_URL=postgresql://crewqual_app:replace-with-runtime-password@postgres:5432/crewqual
DIRECT_URL=postgresql://crewqual:replace-with-owner-password@postgres:5432/crewqual
# Generate two distinct values: openssl rand -hex 48 and openssl rand -hex 32.
# SESSION_SECRET is required whenever SERVICE_MODE=remote (no fallback secret
# exists outside mock mode).
SESSION_SECRET=
SETTINGS_ENCRYPTION_KEY=
# Dedicated 32+ character secret used only by in-container readiness probes.
READINESS_PROBE_SECRET=
# Leave DEV_ENDPOINTS unset outside developer workstations: it enables the
# unauthenticated /api/dev/* helper endpoints (e.g. minting member access
# tokens) on non-production servers.
DEV_ENDPOINTS=false
# Required (32+ random characters) whenever DEV_ENDPOINTS=true in remote mode.
DEV_ENDPOINTS_SECRET=
PILOT_SESSION_TTL_MINUTES=60
ADMIN_SESSION_TTL_HOURS=8
# Deployment-owned outbound boundary. Exact host entries use host or host:port;
# private networks may additionally be granted as CIDR. Application admins
# cannot expand these values. External S3 and remote backup hosts must appear
# in OUTBOUND_ALLOWED_HOSTS even when they resolve publicly.
OUTBOUND_ALLOWED_HOSTS=s3.example.com,host.docker.internal:8000
OUTBOUND_ALLOWED_CIDRS=
S3_ENDPOINT=https://s3.example.com
STORAGE_MODE=external
S3_REGION=us-east-1
S3_BUCKET=crewqual-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SSE_KMS_KEY_ID=
S3_FORCE_PATH_STYLE=false
QWEN_BASE_URL=http://host.docker.internal:8000/v1
QWEN_MODEL=Qwen3.7-35B
SMS_ADAPTER=webhook
SMS_WEBHOOK_URL=https://sms.example.com/send
SMS_WEBHOOK_AUTH_TOKEN=
SMS_RECEIPT_WEBHOOK_SECRET=
# SMS may remain disabled during first-run setup. Member access links are not
# issued until a real webhook is configured in the welcome wizard or settings.
FEISHU_ADAPTER=disabled
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_AUTH_TOKEN=
VLM_ADAPTER=disabled
# Only for an isolated acceptance environment; never set this on live production.
CREWQUAL_ACCEPTANCE_EXTERNALS_DISABLED=0
ACCEPTANCE_ENVIRONMENT_ID=0

# Leave all three empty to create the first super administrator in /setup.
# For non-interactive/headless bootstrap, provide all three values together.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_TOTP_SECRET=
INITIAL_ORGANIZATION_CODE=CREWQUAL
INITIAL_ORGANIZATION_NAME=CrewQual
INITIAL_UNIT_CODE=ROOT
INITIAL_UNIT_NAME=运行单位
INITIAL_TEMPLATE_PACK_CODE=aviation-china-airline-pilot
